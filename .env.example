# ── MuseFlow v2.0 Environment Configuration ────────────────────────────────

# Groq API (LLM backbone for all agents)
GROQ_API_KEY=your_groq_api_key_here

# Hindsight Memory (vectorize.io) — leave blank to use local file fallback
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io/v1

# Loudly API (music generation) — leave blank to use simulated audio fallback
LOUDLY_API_KEY=your_loudly_api_key_here

# Hugging Face Token (used for Flux.1-schnell album cover generation) — leave blank for free keyless Pollinations.ai fallback
HF_TOKEN=your_huggingface_token_here

# ElevenLabs API Key (used for premium vocals) — leave blank for free keyless Google TTS fallback
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Server
PORT=3001

# Legacy (no longer used but kept for reference)
# REPLICATE_API_TOKEN=your_replicate_api_token_here
